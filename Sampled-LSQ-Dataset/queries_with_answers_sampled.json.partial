    "sparql_query": "SELECT DISTINCT  ?o ?p2\nWHERE\n  { ?s  ?p  ?o\n    OPTIONAL\n      { <http://nonsensical.com/1/1457849197533>\n                  ?p2  ?o\n      }\n  }\nLIMIT   1000",
